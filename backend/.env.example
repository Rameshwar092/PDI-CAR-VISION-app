# MongoDB Atlas connection string — from Atlas: Database > Connect > Drivers
# Replace <user>, <password>, <cluster> with your own values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pdi_car_vision

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

UPLOAD_DIR=uploads
MAX_PHOTO_MB=8

# Comma-separated list of origins allowed to call this API.
# Include your deployed frontend's URL here before going live.
# If you package the app as an Android APK (Capacitor), also add https://localhost —
# that's the origin Capacitor's WebView uses by default.
CORS_ORIGINS=http://localhost:5173

# The server refuses to start if JWT_SECRET is still a placeholder value,
# UNLESS this is set to true. Leave this false/unset in production.
ALLOW_INSECURE_SECRET=false

# ---------------------------------------------------------------------------
# Customer "Get your PDI report" page (OTP by SMS)
# ---------------------------------------------------------------------------
BRAND_NAME=PDI Car Vision
OTP_EXPIRE_MINUTES=5
CUSTOMER_TOKEN_MINUTES=30

# console = print OTP in the server log only (testing). For real SMS use one of:
SMS_PROVIDER=console

# --- MSG91 (msg91.com) ---
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your-auth-key
# MSG91_OTP_TEMPLATE_ID=your-dlt-approved-otp-template-id

# --- Fast2SMS (fast2sms.com), DLT route ---
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your-api-key
# FAST2SMS_SENDER_ID=ABCDEF
# FAST2SMS_TEMPLATE_ID=your-dlt-message-id   (template with one {#var#} for the OTP)

# --- Twilio ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx   (or a Messaging Service SID starting with MG)
